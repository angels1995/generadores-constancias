*.pfx

# Cachés y entornos locales de Python.
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Archivos locales del sistema.
.DS_Store
Thumbs.db
Desktop.ini

# Configuración activa privada: conservar las diferencias de PC y VPS.
/config/recursos-pdf.json
/cloudflared.deb
# Recursos profesionales de referencia: conservados localmente, no publicados.
/prototipos/essalud-citt-v1/
/src/assets/**/firma*.png
/src/assets/**/sello*.png
/src/essalud-demo/assets/firma-referencia.png
/src/essalud-demo/assets/sello-referencia.png

# No ignorar config/, data/, docs/, prototipos/, src/assets/ ni tests/:
# contienen recursos y código necesarios para los generadores publicados.
